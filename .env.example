# =============================================================================
# Content Moderation Pipeline — Environment Configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# --- App ---
APP_NAME="Content Moderation Pipeline"
APP_ENV=development                # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Server ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8501"]

# --- Database (PostgreSQL) ---
POSTGRES_USER=moderation_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=content_moderation
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://moderation_user:change-me@localhost:5432/content_moderation

# --- ML Models ---
TEXT_MODEL_NAME=bert-base-uncased
TEXT_MODEL_CHECKPOINT_DIR=./models/text_moderation
TEXT_MODEL_MAX_LENGTH=256
TEXT_LABELS=["toxic","spam","hate"]

IMAGE_MODEL_NAME=ViT-L-14
IMAGE_MODEL_PRETRAINED=openai
IMAGE_MODEL_CHECKPOINT_DIR=./models/image_moderation
IMAGE_LABELS=["nsfw","violence","weapons","hate_symbols","graphic_content"]

# --- Image moderation three-way routing thresholds ---
# NSFW pseudo-probability below this → SAFE
IMAGE_SAFE_THRESHOLD=0.30
# NSFW pseudo-probability above this → NSFW
# Between SAFE_THRESHOLD and NSFW_THRESHOLD → REVIEW (uncertain)
IMAGE_NSFW_THRESHOLD=0.70

DEVICE=cpu                          # cpu | cuda | mps

# --- Confidence-based routing thresholds (all configurable, 0-1 scale) ---
AUTO_DECISION_THRESHOLD=0.95        # >  this -> auto approve/reject
QUEUE_THRESHOLD=0.70                # >= this and <= AUTO_DECISION_THRESHOLD -> moderator queue
# below QUEUE_THRESHOLD -> uncertain / manual review

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=content-moderation

# --- Retraining ---
RETRAIN_SCHEDULE_CRON="0 3 * * 1"   # every Monday 03:00
RETRAIN_MIN_NEW_SAMPLES=100
RETRAIN_DATA_DIR=./data/retraining
RETRAIN_ON_STARTUP=true             # run retrain.py once immediately when the scheduler container starts

# --- Docker Compose host port mappings ---
API_PORT=8000
DASHBOARD_PORT=8501
FRONTEND_PORT=3000
# This URL is embedded into the browser bundle for LOCAL dev only (npm run dev).
# In Docker, the frontend always uses /api/v1 which nginx proxies to the API.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false                      # true in production
LOG_DIR=./logs
