# =============================================================================
# Content Moderation Pipeline — Weekly retraining scheduler image
#
# Runs retrain.py on a cron schedule (settings.retrain_schedule_cron /
# RETRAIN_SCHEDULE_CRON, default weekly Monday 03:00 UTC), plus once
# immediately on container startup.
# =============================================================================
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc cron \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip first — older versions (e.g. 25.x) fail to resolve the regex
# dependency that transformers requires, producing "No matching distribution found".
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

COPY requirements.txt .

# Install CPU-only PyTorch first (~150MB vs 3GB for CUDA) so the build
# finishes in reasonable time even on slower connections.
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
    torch==2.5.1 torchvision==0.20.1

RUN pip install --no-cache-dir -r requirements.txt

COPY app/ ./app/
COPY scripts/ ./scripts/
COPY retrain.py .
COPY configs/ ./configs/
COPY data/sample_text_moderation.csv ./data/sample_text_moderation.csv
COPY docker/retrain-entrypoint.sh /usr/local/bin/retrain-entrypoint.sh

RUN chmod +x /usr/local/bin/retrain-entrypoint.sh \
    && mkdir -p models logs data/retraining

ENTRYPOINT ["/usr/local/bin/retrain-entrypoint.sh"]
