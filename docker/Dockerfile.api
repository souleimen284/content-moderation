# =============================================================================
# Content Moderation Pipeline — FastAPI backend image
# =============================================================================
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# System deps: libpq for psycopg2, curl for the healthcheck.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc curl \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip first — older versions (e.g. 25.x) fail to resolve the regex
# dependency that transformers requires, producing "No matching distribution found".
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

COPY requirements.txt .

# Install CPU-only PyTorch first (~150MB vs 3GB for CUDA) so the build
# finishes in reasonable time even on slower connections.
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
    torch==2.5.1 torchvision==0.20.1

RUN pip install --no-cache-dir -r requirements.txt

COPY app/ ./app/
COPY alembic/ ./alembic/
COPY alembic.ini .
COPY configs/ ./configs/
COPY scripts/ ./scripts/
COPY data/sample_text_moderation.csv ./data/sample_text_moderation.csv

# Runtime directories (models/data/logs are normally volume-mounted in
# docker-compose; created here so the image also runs standalone).
RUN mkdir -p models logs data/uploads data/retraining

# Pre-download both models so API startup does not block behind the frontend
# proxy while waiting for a network download.
ARG TEXT_MODEL_NAME=bert-base-uncased
ARG IMAGE_MODEL_NAME=ViT-B-32
ARG IMAGE_MODEL_PRETRAINED=openai
ARG IMAGE_MODEL_PROVIDER=nudenet
ENV TEXT_MODEL_NAME=${TEXT_MODEL_NAME} \
    IMAGE_MODEL_NAME=${IMAGE_MODEL_NAME} \
    IMAGE_MODEL_PRETRAINED=${IMAGE_MODEL_PRETRAINED} \
    IMAGE_MODEL_PROVIDER=${IMAGE_MODEL_PROVIDER}
COPY docker/pre-download-models.py /tmp/pre-download-models.py
RUN python /tmp/pre-download-models.py && rm /tmp/pre-download-models.py

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
